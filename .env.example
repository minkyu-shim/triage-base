# Copy to .env.local (never committed) and fill in. Only the server reads these.

# --- LLM: any OpenAI-compatible endpoint (developed against Gemini) ---
# e.g. https://generativelanguage.googleapis.com/v1beta/openai/
LLM_BASE_URL=
LLM_API_KEY=
# Default model, e.g. gemini-3.1-flash-lite-preview. Other models to pick from the menu and
# their prices live in config/models.json.
LLM_MODEL=
# Per-attempt timeout in ms (default 20000) and retries (default 2): worst case = timeout × (retries + 1).
LLM_TIMEOUT_MS=
LLM_MAX_RETRIES=
# json_schema (default): the provider enforces the JSON schema. prompt: the schema is described in the prompt.
LLM_STRUCTURED_OUTPUT=
# Optional: max LLM requests per minute during smoke tests (e.g. 15 on the Gemini free tier). Empty = no limit.
LLM_MAX_RPM=

# --- Decision model (optional: the dm and dm+llm strategies need it) ---
# e.g. https://openrouter.ai/api (OpenRouter) or https://api.llmgateway.io (LLM Gateway)
DM_BASE_URL=
DM_API_KEY=
# e.g. typesafe/jev-1.13 (add its price to config/models.json under "dm")
DM_MODEL=
# Path appended to DM_BASE_URL (default /v1/systemone)
DM_PATH=
# Below this probability for category or priority, the DM answer is not trusted alone (default 0.6)
DM_CONFIDENCE_THRESHOLD=
